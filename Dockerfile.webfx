FROM node:22-bookworm-slim AS editor
WORKDIR /src
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund
COPY resources/editor/ resources/editor/
RUN mkdir -p public/studio && npm run build

FROM composer:2 AS composer
FROM php:8.5-apache
WORKDIR /var/www/html
RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip libpng-dev libjpeg62-turbo-dev libwebp-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j2 pdo_mysql exif gd \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*
COPY docker/webfx/site.conf /etc/apache2/sites-available/000-default.conf
RUN apache2ctl configtest
COPY docker/webfx/uploads.ini /usr/local/etc/php/conf.d/webfx.ini
COPY --chmod=755 docker/webfx/init.sh /usr/local/bin/webfx-laravel-init
COPY artisan composer.json composer.lock modules_statuses.json ./
COPY app/ app/
COPY bootstrap/ bootstrap/
COPY config/ config/
COPY database/ database/
COPY lang/ lang/
COPY Modules/ Modules/
COPY public/ public/
COPY resources/ resources/
COPY routes/ routes/
COPY --from=editor /src/public/studio/editor.css public/studio/editor.css
COPY --from=editor /src/resources/editor/build/editor.js resources/editor/build/editor.js
RUN --mount=from=composer,source=/usr/bin/composer,target=/usr/local/bin/composer \
    mkdir -p bootstrap/cache storage/app/private storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader \
    && ln -s ../storage/app/public public/storage \
    && chown -R www-data:www-data storage bootstrap/cache
ARG WEBFX_TEMPLATE_NAME=LBTech
ARG WEBFX_TEMPLATE_SAMPLE=furniture
ARG LICENSE_ISSUER=
ENV APP_NAME=${WEBFX_TEMPLATE_NAME} WEBFX_TEMPLATE_SAMPLE=${WEBFX_TEMPLATE_SAMPLE} LICENSE_ISSUER=${LICENSE_ISSUER}
ENV APP_ENV=production APP_DEBUG=false APP_LOCALE=vi DB_CONNECTION=mysql WEBFX_RUNTIME=1
VOLUME ["/var/www/html/storage"]
EXPOSE 80
